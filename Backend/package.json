{
	"name": "user-control-api",
	"version": "1.0.0",
	"private": true,
	"description": "User management API with hexagonal architecture",
	"packageManager": "pnpm@11.21.0",
	"main": "dist/index.js",
	"scripts": {
		"dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "jest --runInBand",
		"lint": "eslint src test --ext .ts",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"db:migrate": "sequelize-cli db:migrate",
		"db:seed": "sequelize-cli db:seed:all",
		"db:seed:undo": "sequelize-cli db:seed:undo:all"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"mysql2": "^3.14.0",
		"reflect-metadata": "^0.2.2",
		"sequelize": "^6.37.7",
		"sequelize-cli": "^6.6.3",
		"sequelize-typescript": "^2.1.6",
		"tsyringe": "^4.8.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.14",
		"@typescript-eslint/eslint-plugin": "^8.26.1",
		"@typescript-eslint/parser": "^8.26.1",
		"cross-env": "^7.0.3",
		"eslint": "^8.57.1",
		"jest": "^29.7.0",
		"prettier": "^3.5.3",
		"ts-jest": "^29.3.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.8.2"
	}
}
